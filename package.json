{
  "name": "pe-na-trilha-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:production": "env -i PATH=\"$PATH\" NODE_ENV=production APP_ENV=production node src/server.js --local",
    "dev:homologation": "env -i PATH=\"$PATH\" NODE_ENV=production APP_ENV=homologation node src/server.js --local",
    "start": "NODE_ENV=production APP_ENV=production node src/server.js",
    "test": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:integration": "node tests/integration/run.js",
    "lint": "eslint src",
    "admin:provisionar": "node tools/provisionar-primeiro-admin.js",
    "admin:promover": "node tools/gerenciar-admin.js promover",
    "admin:remover": "node tools/gerenciar-admin.js remover"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "file-type": "^22.3.0",
    "jose": "^6.2.16",
    "mongoose": "^9.7.2",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@jest/reporters": {
      "glob": "14.0.6"
    },
    "jest-config": {
      "glob": "14.0.6"
    },
    "jest-runtime": {
      "glob": "14.0.6"
    },
    "test-exclude": {
      "glob": "14.0.6",
      "minimatch": "11.0.9"
    }
  }
}
