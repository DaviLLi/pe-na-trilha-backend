# URI SRV do usuário de homologação, com /pe_na_trilha_homologacao como caminho.
MONGO_URI_HOMOLOGATION=
MONGO_HOST_HOMOLOGATION=pe-na-trilha-testes.vcnkitn.mongodb.net
JWT_SECRET=
CSRF_SECRET=
AUTH_COOKIE_SAME_SITE=none
# Mesmo Cloud Name de produção e uma chave de homologação com acesso à pasta reservada.
HOMOLOGATION_CLOUDINARY_CLOUD_NAME=
HOMOLOGATION_CLOUDINARY_API_KEY=
HOMOLOGATION_CLOUDINARY_API_SECRET=
HOMOLOGATION_CLOUDINARY_PREFIX=homologacao/
# Consulte o modo do Product Environment e preencha com dynamic ou fixed.
HOMOLOGATION_CLOUDINARY_FOLDER_MODE=
